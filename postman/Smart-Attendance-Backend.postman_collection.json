    {
      "name": "07 - Attendance Verification and Records",
      "item": [
        {
          "name": "Verify Attendance - Save Attendance ID",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.attendanceId) { pm.environment.set('attendanceId', body.attendanceId); }",
              "}"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "image", "type": "file", "src": "{{faceImagePath}}", "description": "Use the same student's face image." }]
            },
            "url": "{{baseUrl}}/attendance/verify?sessionId={{sessionId}}"
          }
        },
        {
          "name": "ESP32 Identify Attendance",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "X-Device-Id", "value": "{{hardwareDeviceId}}", "type": "text" },
              { "key": "X-Device-Key", "value": "{{hardwareDeviceKey}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "image", "type": "file", "src": "{{faceImagePath}}", "description": "Simulates the JPEG captured by the ESP32-CAM." }]
            },
            "url": "{{baseUrl}}/hardware/v1/attendance/identify?sessionId={{sessionId}}",
            "description": "Uses device headers instead of a JWT. Because the student verification request runs first, this normally demonstrates the ALREADY_VERIFIED response."
          }
        },
        {
          "name": "List Attendance as Admin",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/attendance?sessionId={{sessionId}}&courseId={{courseId}}&studentId={{studentId}}&page=0&size=20" }
        },
        {
          "name": "List Attendance as Teacher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherAccessToken}}", "type": "string" }] },
