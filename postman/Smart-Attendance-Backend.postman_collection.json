    {
      "name": "06 - Face Registration",
      "description": "Set faceImagePath in the environment or choose a local JPEG/PNG/WebP file in Postman before sending the registration request. FastAPI must be running on localhost:8000 because Spring coordinates the call.",
      "item": [
        {
          "name": "Register Student Face",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentAccessToken}}", "type": "string" }] },
