    { "key": "semester", "value": "FIRST" },
    { "key": "academicYear", "value": "2026-2027" },
    { "key": "faceImagePath", "value": "/absolute/path/to/student-face.jpg" },
    { "key": "hardwareDeviceId", "value": "CLASSROOM-01" },
    { "key": "hardwareDeviceKey", "value": "change-this-device-secret" },
    { "key": "today", "value": "" },
