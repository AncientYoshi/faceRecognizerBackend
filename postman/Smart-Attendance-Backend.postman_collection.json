{
  "info": {
    "_postman_id": "6bd7f15b-3d16-4f76-9982-af5316daab56",
    "name": "Smart Attendance Backend",
    "description": "Complete Spring Boot API collection for Smart Attendance milestones 1-4. Run folders 00 through 11 in order; folder 99 contains manual lifecycle and cleanup operations. Scripts save JWTs and resource IDs into the selected environment automatically. Before face requests, set faceImagePath or select an image in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const start = new Date(now.getTime() - 60 * 1000);",
          "const end = new Date(now.getTime() + 30 * 60 * 1000);",
          "const mondayOffset = (now.getUTCDay() + 6) % 7;",
          "const monday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - mondayOffset));",
          "pm.collectionVariables.set('today', now.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('weekStart', monday.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('currentMonth', now.toISOString().slice(0, 7));",
          "pm.collectionVariables.set('sessionStart', start.toISOString());",
          "pm.collectionVariables.set('sessionEnd', end.toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response status is successful', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change-this-password" },
    { "key": "teacherEmail", "value": "postman.teacher@example.com" },
    { "key": "teacherPassword", "value": "teacher-password" },
    { "key": "studentEmail", "value": "postman.student@example.com" },
