    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login Admin - Save Tokens",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('adminAccessToken', body.accessToken);",
              "  pm.environment.set('adminRefreshToken', body.refreshToken);",
              "}"
            ] }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login",
            "description": "Logs in the bootstrap administrator and stores adminAccessToken/adminRefreshToken."
          }
        },
        {
          "name": "Refresh Admin Token - Rotate Tokens",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
