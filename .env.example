DB_URL=jdbc:postgresql://localhost:5432/smart_attendance
DB_USERNAME=smart_attendance
DB_PASSWORD=smart_attendance

JWT_ISSUER=smart-attendance-backend
JWT_SECRET=replace-with-a-long-random-secret-containing-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ALLOWED_ORIGINS=http://localhost:4200
